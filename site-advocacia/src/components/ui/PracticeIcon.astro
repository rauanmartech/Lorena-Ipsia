---
interface Props {
  variant: 'document' | 'columns' | 'justice';
}

const { variant } = Astro.props;
---

<span class="practice-icon" aria-hidden="true">
  {variant === 'document' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 5.5h10l4 4V26H9z" />
      <path d="M19 5.5v4h4M12.5 14h7M12.5 18h7M12.5 22h4" />
    </svg>
  )}
  {variant === 'columns' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 10h22M7 7h18l2 3H5zM5 25h22M7 22h18v3H7z" />
      <path d="M9 11v11M15.5 11v11M22 11v11" />
    </svg>
  )}
  {variant === 'justice' && (
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M16 5v21M9 26h14M7 11h18M10 11l-3 8h6l-3-8ZM22 11l-3 8h6l-3-8Z" />
      <path d="M14 7.5a2 2 0 0 1 4 0" />
    </svg>
  )}
</span>

<style>
  .practice-icon {
    width: 34px;
    height: 34px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #f7f6f2;
    background: var(--navy-deep);
  }
  svg { width: 23px; height: 23px; }
</style>
