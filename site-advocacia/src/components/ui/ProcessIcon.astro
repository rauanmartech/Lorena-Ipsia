---
interface Props {
  variant: 'conversation' | 'analysis' | 'guidance';
}

const { variant } = Astro.props;
---

<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {variant === 'conversation' && (
    <>
      <path d="M7 10h34v24H21L11 41v-7H7V10Z" />
      <path d="M14 18h20M14 24h15" />
    </>
  )}
  {variant === 'analysis' && (
    <>
      <path d="M10 5h19l7 7v28H10V5Z" />
      <path d="M29 5v8h7M16 20h13M16 26h9" />
      <circle cx="30" cy="31" r="5" />
      <path d="m34 35 6 6" />
    </>
  )}
  {variant === 'guidance' && (
    <>
      <circle cx="24" cy="24" r="18" />
      <path d="M24 12v24M12 24h24" />
      <path d="m19 29 11-11-3 9-8 2Z" />
    </>
  )}
</svg>

<style>
  svg { width: 42px; height: 42px; }
</style>
