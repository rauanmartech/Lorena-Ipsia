---
import { site } from '../../content/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-ornament" aria-hidden="true">
    <span class="ornament-line"></span>
    <span class="ornament-diamond diamond-one"></span>
    <span class="ornament-diamond diamond-two"></span>
    <span class="ornament-diamond diamond-three"></span>
  </div>

  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow">{site.hero.eyebrow}</p>

      <h1 id="hero-title">
        <span>{site.hero.titleStart}</span>
        <span>{site.hero.titleMiddle}</span>
        <span class="title-accent">{site.hero.titleAccent}</span>
      </h1>

      <span class="hero-rule" aria-hidden="true"></span>
      <p class="hero-description">{site.hero.description}</p>

      <div class="hero-actions">
        <a class="hero-button hero-button-primary" href="#atuacao">Áreas de atuação <span aria-hidden="true">↗</span></a>
        <a class="hero-button hero-button-secondary" href="#contato">Entrar em contato <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(650px, calc(100svh - 84px), 900px);
    overflow: hidden;
    color: #f6f5f2;
    background-color: var(--navy-deep);
    background-image: url('/images/hero-advogada-v1.png');
    background-size: cover;
    background-position: center 47%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(5, 13, 26, .55) 0%, rgba(5, 13, 26, .32) 35%, rgba(5, 13, 26, .04) 67%, transparent 100%);
    pointer-events: none;
  }

  .hero-inner {
    min-height: inherit;
    display: flex;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-copy {
    width: min(100%, 660px);
    padding-block: 5rem;
    padding-left: clamp(2.5rem, 5vw, 5rem);
  }

  .hero-eyebrow {
    color: #e6e5e2;
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  h1 {
    display: flex;
    flex-direction: column;
    margin-top: 1.85rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(3.5rem, 5.6vw, 6.2rem);
    line-height: .98;
    letter-spacing: -.055em;
  }

  h1 span { display: block; white-space: nowrap; }
  .title-accent { color: var(--gold-light); }

  .hero-rule {
    display: block;
    width: 70px;
    height: 1px;
    margin-top: 2.5rem;
    background: var(--gold);
  }

  .hero-description {
    max-width: 430px;
    margin-top: 1.3rem;
    color: #e0e0dc;
    font-size: 1rem;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }

  .hero-button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem;
    padding: .85rem 1.3rem;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .09em;
    text-transform: uppercase;
    transition: background-color .2s ease, border-color .2s ease, transform .2s ease;
  }

  .hero-button:hover { transform: translateY(-2px); }
  .hero-button span { font-size: 1rem; line-height: 1; }
  .hero-button-primary { background: var(--gold); color: var(--navy-deep); border: 1px solid var(--gold); }
  .hero-button-primary:hover { background: #e0c18c; border-color: #e0c18c; }
  .hero-button-secondary { color: #f6f5f2; border: 1px solid var(--gold); }
  .hero-button-secondary:hover { background: rgba(196, 158, 95, .15); }

  .hero-ornament {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: 0;
    width: clamp(75px, 9vw, 135px);
    overflow: hidden;
    opacity: .55;
    pointer-events: none;
  }

  .ornament-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 23%;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(203, 169, 110, .55) 20%, rgba(203, 169, 110, .3) 75%, transparent);
  }

  .ornament-diamond {
    position: absolute;
    width: 112px;
    height: 112px;
    border: 1px solid rgba(203, 169, 110, .48);
    transform: rotate(45deg);
  }

  .diamond-one { top: 10%; left: -76px; }
  .diamond-two { top: 23%; left: -29px; }
  .diamond-three { top: 36%; left: -76px; }

  @media (max-width: 1150px) {
    .hero-copy { width: min(100%, 590px); padding-left: clamp(1rem, 3vw, 3rem); }
    h1 { font-size: clamp(3.4rem, 6vw, 5rem); }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: max(760px, calc(100svh - 76px));
      background-position: 72% top;
    }
    .hero::before {
      background: linear-gradient(180deg, rgba(5, 13, 26, .08) 0%, rgba(5, 13, 26, .18) 32%, rgba(5, 13, 26, .88) 62%, #07111f 100%);
    }
    .hero-inner { align-items: end; }
    .hero-copy { padding: 24rem 0 4.5rem; width: min(100%, 570px); }
    .hero-ornament { width: 65px; opacity: .38; }
    .ornament-diamond { width: 75px; height: 75px; }
    .diamond-one { left: -55px; top: 45%; }
    .diamond-two { left: -26px; top: 53%; }
    .diamond-three { left: -55px; top: 61%; }
    h1 { font-size: clamp(3.1rem, 10vw, 4.8rem); margin-top: 1.3rem; }
    .hero-rule { margin-top: 1.8rem; }
    .hero-description { font-size: .91rem; }
  }

  @media (max-width: 420px) {
    .hero-copy { padding-top: 23rem; padding-bottom: 3.5rem; }
    h1 { font-size: clamp(2.65rem, 9.1vw, 3.3rem); }
    .hero-button { width: 100%; }
  }
</style>
